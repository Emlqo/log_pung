# 개발용 SQLite. 운영은 postgresql+psycopg://USER:PASSWORD@HOST/DATABASE
DATABASE_URL=sqlite:///./pilot.db
GOOGLE_CLIENT_ID=
SCHOOL_ID=school-pilot
# 확인된 시험 학생 2~3명만 쉼표로 지정. 비어 있으면 전부 거부.
TEST_ACCOUNT_EMAILS=
ALLOWED_DEVICE_IDS=
# diagnostic은 인증된 시험 계정의 미확인 기기 상태만 허용. 정상 기기라고 판정하지 않음.
DEVICE_POLICY=diagnostic
TEACHER_USER=teacher
# scripts/password.py 결과를 넣음. 학생 확장에는 배포하지 않음.
TEACHER_PASSWORD_HASH=
RETENTION_DAYS=14
