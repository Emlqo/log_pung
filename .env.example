# Vercel project environment variables: all values here are blank placeholders.
# External PostgreSQL pooled connection URL using psycopg, preferably sslmode=require.
DATABASE_URL=
SCHOOL_ID=school-pilot
# Student deployment targets are selected in Admin console; no email allowlist.
# Optional: only used when DEVICE_POLICY=allowlist
ALLOWED_DEVICE_IDS=
# False until the server settings and limited group have been checked.
STUDENT_TEST_ENABLED=false
# Generated by server/scripts/password.py; server only, never in the extension.
TEACHER_PASSWORD_HASH=

# All policy-installed profiles, no individual device registration.
DEVICE_POLICY=policy

# Vercel daily retention job: random secret, server only. Never put in extension.
CRON_SECRET=
