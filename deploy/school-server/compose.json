{
  "services": {
    "proxy": {
      "image": "caddy:2",
      "restart": "unless-stopped",
      "ports": ["80:80", "443:443"],
      "environment": {"PILOT_DOMAIN": "${PILOT_DOMAIN:?actual DNS hostname required}"},
      "volumes": ["./Caddyfile:/etc/caddy/Caddyfile:ro", "caddy-data:/data", "caddy-config:/config"],
      "depends_on": ["api"]
    },
    "api": {
      "build": {"context": "../..", "dockerfile": "deploy/school-server/Dockerfile"},
      "restart": "unless-stopped",
      "environment": {
        "PILOT_DOMAIN": "${PILOT_DOMAIN:?actual DNS hostname required}",
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID:?Chrome Extension OAuth client ID required}",
        "SCHOOL_ID": "${SCHOOL_ID:?school ID required}",
        "TEST_ACCOUNT_EMAILS": "${TEST_ACCOUNT_EMAILS:?two or three pilot emails required}",
        "DEVICE_POLICY": "${DEVICE_POLICY:-diagnostic}",
        "ALLOWED_DEVICE_IDS": "${ALLOWED_DEVICE_IDS:-}",
        "TEACHER_USER": "teacher",
        "RETENTION_DAYS": "14",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/db_password",
        "TEACHER_PASSWORD_HASH_FILE": "/run/secrets/teacher_hash"
      },
      "secrets": ["db_password", "teacher_hash"],
      "depends_on": {"db": {"condition": "service_healthy"}},
      "healthcheck": {
        "test": ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=3)"],
        "interval": "30s", "timeout": "5s", "retries": 3
      }
    },
    "db": {
      "image": "postgres:17",
      "restart": "unless-stopped",
      "environment": {"POSTGRES_DB": "pilot", "POSTGRES_USER": "pilot", "POSTGRES_PASSWORD_FILE": "/run/secrets/db_password"},
      "secrets": ["db_password"],
      "volumes": ["pilot-db:/var/lib/postgresql/data"],
      "healthcheck": {"test": ["CMD-SHELL", "pg_isready -U pilot -d pilot"], "interval": "10s", "timeout": "5s", "retries": 5}
    }
  },
  "volumes": {"pilot-db": {}, "caddy-data": {}, "caddy-config": {}},
  "secrets": {
    "db_password": {"file": "./secrets/db-password.txt"},
    "teacher_hash": {"file": "./secrets/teacher-hash.txt"}
  }
}
