{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance/retention",
      "schedule": "0 19 * * *"
    }
  ]
}
