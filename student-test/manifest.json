{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "경기도교육청 보안 프로그램",
  "version": "0.2.4",
  "description": "수업활동(방문 사이트·검색어)을 기록하여 학교 서버로 전송합니다.",
  "permissions": [
    "identity",
    "identity.email",
    "enterprise.deviceAttributes",
    "storage",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "https://pilot.example.invalid/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "student-test/src/worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "경기도교육청 보안 프로그램"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "storage": {
    "managed_schema": "managed-schema.json"
  }
}
